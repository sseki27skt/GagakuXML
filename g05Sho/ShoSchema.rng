<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:mei="http://www.music-encoding.org/ns/mei"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <include href="https://music-encoding.org/schema/5.1/mei-all.rng"/>
  <start combine="choice">
    <element name="gagakuXML">
      <element name="gagakuMeta">
        <ref name="mei_meiHead"/>
        <element name="gagakuHead">
          <element name="choshi">
            <a:documentation>楽曲の調子を示す．</a:documentation>
            <choice>
              <value>壱越調</value>
              <value>平調</value>
              <value>双調</value>
              <value>黄鐘調</value>
              <value>盤渉調</value>
              <value>太食調</value>
              <value>太食調</value>
            </choice>
          </element>
          <element name="title">
            <attribute name="xml:id">
              <data type="NCName"/>
            </attribute>
            <data type="string"/>
          </element>
          <optional>
            <element name="sizeCategory">
              <a:documentation>大曲・中曲・小曲の別を示す．</a:documentation>
              <choice>
                <value>大曲</value>
                <value>中曲</value>
                <value>小曲</value>
                <value>准大曲</value>
                <value/>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="hyoshi">
              <a:documentation>楽曲の拍子を示す．</a:documentation>
              <attribute name="type">
                <value>hyoshi-1</value>
              </attribute>
              <choice>
                <value>早四拍子</value>
                <value>早八拍子</value>
                <value>延四拍子</value>
                <value>延八拍子</value>
                <value>早只四拍子</value>
                <value>早只八拍子</value>
                <value>早六拍子</value>
                <value>由利吹</value>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="hyoshi">
              <a:documentation>楽曲の拍子を示す．</a:documentation>
              <attribute name="type">
                <value>hyoshi-2</value>
              </attribute>
              <choice>
                <value>拍子十六</value>
                <value>拍子十</value>
                <value>拍子二十</value>
                <value>拍子八</value>
                <value>拍子十四</value>
                <value>拍子七</value>
                <value>拍子六</value>
                <value>拍子十二</value>
                <value>拍子十七</value>
                <value>拍子十一</value>
                <value>拍子十八</value>
                <value>拍子十五</value>
                <value>拍子九</value>
                <value>拍子二十三</value>
                <value>拍子二十四</value>
                <value>拍子二十六</value>
                <value>拍子二十一</value>
                <value/>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="kuwaeHyoshi">
              <a:documentation>加拍子を示す．</a:documentation>
              <data type="string"/>
            </element>
          </optional>
          <optional>
            <element name="kodo">
              <a:documentation>後度の表示を示す．</a:documentation>
              <data type="string"/>
            </element>
          </optional>
        </element>
      </element>
      <element name="music">
        <element name="front">
          <element name="title">
            <data type="string"/>
          </element>
          <optional>
            <element name="sizeCategory">
              <a:documentation>大曲・中曲・小曲の別を示す．</a:documentation>
              <choice>
                <value>大曲</value>
                <value>中曲</value>
                <value>小曲</value>
                <value>准大曲</value>
                <value/>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="hyoshi">
              <a:documentation>楽曲の拍子を示す．</a:documentation>
              <attribute name="type">
                <value>hyoshi-1</value>
              </attribute>
              <choice>
                <value>早四拍子</value>
                <value>早八拍子</value>
                <value>延四拍子</value>
                <value>延八拍子</value>
                <value>早只四拍子</value>
                <value>早只八拍子</value>
                <value>早六拍子</value>
                <value>由利吹</value>
                <data type="NCName"/>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="hyoshi">
              <a:documentation>楽曲の拍子を示す．</a:documentation>
              <attribute name="type">
                <value>hyoshi-2</value>
              </attribute>
              <choice>
                <value>拍子十六</value>
                <value>拍子十</value>
                <value>拍子二十</value>
                <value>拍子八</value>
                <value>拍子十四</value>
                <value>拍子七</value>
                <value>拍子六</value>
                <value>拍子十二</value>
                <value>拍子十七</value>
                <value>拍子十一</value>
                <value>拍子十八</value>
                <value>拍子十五</value>
                <value>拍子九</value>
                <value>拍子二十三</value>
                <value>拍子二十四</value>
                <value>拍子二十六</value>
                <value>拍子二十一</value>
                <value/>
              </choice>
            </element>
          </optional>
          <optional>
            <element name="kuwaeHyoshi">
              <a:documentation>加拍子を示す．</a:documentation>
              <data type="string"/>
            </element>
          </optional>
          <optional>
            <element name="kodo">
              <a:documentation>後度の表示を示す．</a:documentation>
              <data type="string"/>
            </element>
          </optional>


        </element>
        <element name="body">

          <oneOrMore><choice>
            <oneOrMore>
              <choice>
                <element name="cell">
                  <optional>
                  <attribute name="id">
                    <data type="NCName"/>
                  </attribute>
                  </optional>
                  <oneOrMore>
                    <choice>
                      <element name="hyoshi">
                        <optional>
                          <attribute name="id">
                            <data type="NCName"/>
                          </attribute>
                        </optional>
                        <attribute name="type">
                          <choice>
                            <value>large</value>
                            <value>small</value>
                          </choice>
                        </attribute>
                      </element>
                      <element name="aitake">
                        <optional>
                          <attribute name="id">
                            <data type="NCName"/>
                          </attribute>
                        </optional>
                        <attribute name="label">
                          <choice>
                            <value>.</value>
                            <value>一</value>
                            <value>下</value>
                            <value>乙</value>
                            <value>乞</value>
                            <value>凢</value>
                            <value>十</value>
                            <value>工</value>
                            <value>引</value>
                            <value>美</value>
                            <value>行</value>
                          </choice>
                        </attribute>
                        <optional>
                          <attribute name="hyphenation">
                            <choice>
                              <value>begin</value>
                              <value>end</value>
                            </choice>
                          </attribute>
                        </optional>
                        <empty/>
                      </element>
                    </choice>
                  </oneOrMore>
                </element>
                <element name="hanjo">
                  <data type="NCName"/>
                  <optional>
                    <attribute name="place">
                      <data type="NCName"/>
                    </attribute>
                  </optional>
                </element>
                <element name="ichinoku">
                  <data type="NCName"/>
                </element>
                <element name="juto">
                  <data type="NCName"/>
                </element>
                <element name="kaeshiduke">
                  <empty/>
                  <optional>
                    <attribute name="place">
                      <data type="NCName"/>
                    </attribute>
                  </optional>
                </element>
                <element name="kando">
                  <data type="NCName"/>
                  <optional>
                    <attribute name="place">
                      <data type="NCName"/>
                    </attribute>
                  </optional>
                </element>
                <element name="koreyori">
                  <data type="NCName"/>
                </element>
                <element name="lb">
                  <optional>
                  <attribute name="n">
                    <data type="integer"/>
                  </attribute>
                  </optional>
                </element>
                <element name="nihen">
                  <data type="NCName"/>
                  <optional>
                    <attribute name="place">
                      <data type="NCName"/>
                    </attribute>
                  </optional>
                  <optional>
                    <attribute name="type">
                      <data type="string"/>
                    </attribute>
                  </optional>
                </element>
                <element name="nijo">
                  <data type="NCName"/>
                </element>
                <element name="ninoku">
                  <data type="NCName"/>
                </element>
                <element name="pb">
                  <empty/>
                </element>
                <element name="sannoku">
                  <data type="NCName"/>
                </element>
                <element name="tsukedokoro">
                  <optional>
                    <attribute name="type">
                      <data type="string"/>
                    </attribute>
                  </optional>
                  <optional>
                    <attribute name="place">
                      <data type="NCName"/>
                    </attribute>
                  </optional>
                  <data type="string"/>
                </element>
                <element name="jobuki">
                  <empty/>
                </element>
                <!-- Sho often has text elements for glosses? -->
                <element name="text">
                    <data type="string"/>
                </element>
              </choice>
            </oneOrMore>
            <element name="section">
              <oneOrMore>
                <choice>
                  <element name="cell">
                    <optional>
                    <attribute name="id">
                      <data type="NCName"/>
                    </attribute>
                    </optional>
                    <oneOrMore>
                      <choice>
                        <element name="hyoshi">
                          <optional>
                            <attribute name="id">
                              <data type="NCName"/>
                            </attribute>
                          </optional>
                          <attribute name="type">
                            <choice>
                              <value>large</value>
                              <value>small</value>
                            </choice>
                          </attribute>
                        </element>
                        <element name="aitake">
                          <optional>
                            <attribute name="id">
                              <data type="NCName"/>
                            </attribute>
                          </optional>
                          <attribute name="label">
                            <choice>
                              <value>.</value>
                              <value>一</value>
                              <value>下</value>
                              <value>乙</value>
                              <value>乞</value>
                              <value>凢</value>
                              <value>十</value>
                              <value>工</value>
                              <value>引</value>
                              <value>美</value>
                              <value>行</value>
                            </choice>
                          </attribute>
                          <optional>
                            <attribute name="hyphenation">
                              <choice>
                                <value>begin</value>
                                <value>end</value>
                              </choice>
                            </attribute>
                          </optional>
                          <empty/>
                        </element>
                      </choice>
                    </oneOrMore>
                  </element>
                  <element name="hanjo">
                    <data type="NCName"/>
                    <optional>
                      <attribute name="place">
                        <data type="NCName"/>
                      </attribute>
                    </optional>
                  </element>
                  <element name="ichinoku">
                    <data type="NCName"/>
                  </element>
                  <element name="juto">
                    <data type="NCName"/>
                  </element>
                  <element name="kaeshiduke">
                    <empty/>
                    <optional>
                      <attribute name="place">
                        <data type="NCName"/>
                      </attribute>
                    </optional>
                  </element>
                  <element name="kando">
                    <empty/>
                    <optional>
                      <attribute name="place">
                        <data type="NCName"/>
                      </attribute>
                    </optional>
                  </element>
                  <element name="koreyori">
                    <data type="NCName"/>
                  </element>
                  <element name="lb">
                    <optional>
                    <attribute name="n">
                      <data type="integer"/>
                    </attribute>
                    </optional>
                  </element>
                  <element name="nihen">
                    <data type="NCName"/>
                    <optional>
                      <attribute name="place">
                        <data type="NCName"/>
                      </attribute>
                    </optional>
                    <optional>
                      <attribute name="type">
                        <data type="string"/>
                      </attribute>
                    </optional>
                  </element>
                  <element name="nijo">
                    <data type="NCName"/>
                  </element>
                  <element name="ninoku">
                    <data type="NCName"/>
                  </element>
                  <element name="pb">
                    <empty/>
                  </element>
                  <element name="sannoku">
                    <data type="NCName"/>
                  </element>
                  <element name="tsukedokoro">
                    <optional>
                      <attribute name="type">
                        <data type="string"/>
                      </attribute>
                    </optional>
                    <optional>
                      <attribute name="place">
                        <data type="NCName"/>
                      </attribute>
                    </optional>
                    <data type="string"/>
                  </element>
                  <element name="jobuki">
                    <empty/>
                  </element>
                  <element name="text">
                    <data type="string"/>
                </element>
                </choice>
              </oneOrMore>
            </element>  
          </choice></oneOrMore>

        </element>
      </element>
    </element>
  </start>
</grammar>
